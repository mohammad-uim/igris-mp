{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "igris-mp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3706c960-e7e8-444e-8057-317db0fa997b","database_name": "IGRIS-MP" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "273c1c5fcc89478eb87fdf0e6a77adf9" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
